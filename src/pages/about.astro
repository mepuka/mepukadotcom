---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Mepuka" description="About me">
  <h1>About</h1>

  <div class="content">
    <p class="lead">
      I'm <strong>Mepuka Kessy</strong>, a software engineer based in Chicago and Seattle.
    </p>

    <p>
      I have an interest in backend development and typed functional programming.
      Currently obsessed with the power of building things with AI and <a href="https://effect.website">Effect</a>.
    </p>

    <p>
      This site is built with Astro, running on Cloudflare Pages.
    </p>

    <p>
      Find me on <a href="https://github.com/mepuka">GitHub</a>.
    </p>
  </div>
</BaseLayout>

<style>
  h1 {
    margin-bottom: var(--space-6);
  }

  .content {
    max-width: 60ch;
  }

  .content p {
    margin-bottom: var(--space-6);
  }

  .lead {
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--color-ink);
    border-left: 3px solid var(--color-terracotta);
    padding-left: var(--space-4);
  }

  .lead strong {
    font-family: var(--font-heading);
    font-weight: 600;
  }
</style>
